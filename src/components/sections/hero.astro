---
---

<section class="hero" id="hero">
  <div class="hero-grid-frame" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="status-pill">
      <span class="status-dot" aria-hidden="true"></span>
      <span>Available for contract work</span>
    </div>

    <div class="hero-main">
      <!-- LEFT column: identity + CTA -->
      <div class="hero-left">
        <h1 class="hero-title">Dam Hong Phuc</h1>
        <p class="hero-tagline">AI Solution Architect</p>

        <div class="hero-cta-row">
          <a href="#work" class="cta-primary">
            <span>View Work</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </a>
          <a href="/CV_DamHongPhuc_AI_SA.pdf" class="cta-resume" target="_blank" rel="noopener noreferrer">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" y1="13" x2="8" y2="13"/>
              <line x1="16" y1="17" x2="8" y2="17"/>
              <polyline points="10 9 9 9 8 9"/>
            </svg>
            <span>Resume</span>
          </a>
        </div>
      </div>

      <!-- RIGHT column: value prop + highlight -->
      <div class="hero-right">
        <p class="hero-subtitle">
          I build production-grade <strong>Agentic AI Systems</strong> for enterprises, with deep expertise in <strong>HR &amp; Legal</strong> workflows.
        </p>

        <div class="fortune-callout">
          <svg class="callout-icon" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M13 2L3 14h8l-1 8 10-12h-8l1-8z"/>
          </svg>
          <div class="callout-text">
            <span class="callout-kicker">Shipped at</span>
            <span class="callout-headline">Fortune 500 scale</span>
          </div>
        </div>

        <ul class="cert-row" aria-label="AWS certifications">
          <li>
            <a
              class="cert-chip"
              href="https://www.credly.com/badges/7baa905d-a3a2-4959-971f-09b97ce94feb/public_url"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg class="cert-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 2l8 3.5v5.5c0 5-3.4 9.3-8 11-4.6-1.7-8-6-8-11V5.5z"/>
                <path d="M9 12l2 2 4-4"/>
              </svg>
              <span class="cert-text">
                <span class="cert-name">AWS Certified GenAI Developer</span>
                <span class="cert-level">Professional &middot; AIP-C01</span>
              </span>
            </a>
          </li>
          <li>
            <a
              class="cert-chip"
              href="https://www.credly.com/badges/4aa6aed5-0d54-4a35-9bc3-b3ccb191f0a6/public_url"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg class="cert-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 2l8 3.5v5.5c0 5-3.4 9.3-8 11-4.6-1.7-8-6-8-11V5.5z"/>
                <path d="M9 12l2 2 4-4"/>
              </svg>
              <span class="cert-text">
                <span class="cert-name">AWS Certified Solutions Architect</span>
                <span class="cert-level">Associate &middot; SAA-C03</span>
              </span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
    padding: 7rem 5% 4rem;
    position: relative;
  }

  /* Decorative gradient-border frame */
  .hero-grid-frame {
    position: absolute;
    inset: 6rem 5% 4rem;
    border-radius: var(--radius-2xl);
    pointer-events: none;
    border: 1px solid transparent;
    background:
      linear-gradient(180deg, transparent, transparent) padding-box,
      linear-gradient(135deg, rgba(37, 99, 235, 0.22), rgba(14, 165, 233, 0.22), rgba(6, 182, 212, 0.22)) border-box;
    opacity: 0.55;
    mask: linear-gradient(180deg, transparent, black 15%, black 85%, transparent);
    -webkit-mask: linear-gradient(180deg, transparent, black 15%, black 85%, transparent);
  }

  .hero-inner {
    position: relative;
    max-width: 1240px;
    width: 100%;
    margin: 0 auto;
    animation: fade-in-up 700ms var(--ease-premium) both;
  }

  /* Status pill — top center */
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius-pill);
    background: rgba(34, 197, 94, 0.10);
    border: 1px solid rgba(34, 197, 94, 0.22);
    color: #15803d;
    font-size: 0.82rem;
    font-weight: 600;
    margin-bottom: 2.5rem;
  }
  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.22);
    animation: pulse-dot 2s var(--ease-out) infinite;
  }
  @keyframes pulse-dot {
    0%, 100% { box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.22); }
    50%      { box-shadow: 0 0 0 8px rgba(34, 197, 94, 0.08); }
  }

  /* Two-column main row */
  .hero-main {
    display: grid;
    grid-template-columns: minmax(280px, 1fr) minmax(320px, 1.25fr);
    gap: 3.5rem;
    align-items: stretch;
    text-align: left;
  }

  /* LEFT — identity */
  .hero-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    line-height: 1.1;
    letter-spacing: -0.045em;
    margin: 0;
    padding-bottom: 0.05em;
    background: linear-gradient(135deg, #0f172a 0%, #0ea5e9 60%, #06b6d4 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    background-size: 200% 100%;
    background-position: 0% 50%;
    transition: background-position 800ms var(--ease-premium);
  }
  .hero-title:hover { background-position: 100% 50%; }

  .hero-tagline {
    font-family: var(--font-heading);
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    font-weight: 500;
    color: #4b5563;
    letter-spacing: 0.18em;
    margin: 0.75rem 0 1.25rem;
    text-transform: uppercase;
  }

  .hero-cta-row {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 170px;
    padding: 0.9rem 1.5rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.97rem;
    color: white;
    background: linear-gradient(135deg, var(--color-accent-primary), var(--color-accent-secondary));
    box-shadow: var(--shadow-glow-primary), 0 4px 12px rgba(37, 99, 235, 0.20);
    transition: transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
  }

  .cta-resume {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 170px;
    padding: 0.9rem 1.5rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.97rem;
    color: var(--color-accent-primary);
    background: #ffffff;
    border: 1px solid rgba(37, 99, 235, 0.28);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04), 0 4px 12px rgba(37, 99, 235, 0.08);
    transition: transform var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
  }
  .cta-resume:hover {
    transform: translateY(-2px);
    border-color: rgba(37, 99, 235, 0.55);
    box-shadow: 0 4px 8px rgba(15, 23, 42, 0.04), 0 12px 28px rgba(37, 99, 235, 0.18);
  }
  .cta-resume:active { transform: translateY(0) scale(0.98); }
  .cta-resume svg { transition: transform var(--duration-base) var(--ease-spring); }
  .cta-resume:hover svg { transform: translateY(-1px); }
  .cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-glow-secondary), 0 12px 32px rgba(37, 99, 235, 0.30);
  }
  .cta-primary:active { transform: translateY(0) scale(0.98); }
  .cta-primary svg { transition: transform var(--duration-base) var(--ease-spring); }
  .cta-primary:hover svg { transform: translateX(4px); }

  /* RIGHT — value prop */
  .hero-right {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
    padding-left: 2rem;
    border-left: 1px solid rgba(15, 23, 42, 0.08);
  }

  .hero-subtitle {
    font-size: clamp(1.15rem, 1.7vw, 1.45rem);
    line-height: 1.5;
    color: var(--color-text-primary);
    margin: 0;
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .hero-subtitle strong {
    color: var(--color-accent-primary);
    font-weight: 600;
  }

  /* Fortune 500 callout — soft glassmorphism, no harsh border */
  .fortune-callout {
    display: inline-flex;
    align-items: center;
    gap: 0.95rem;
    padding: 1rem 1.35rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.05), rgba(14, 165, 233, 0.06), rgba(6, 182, 212, 0.06));
    border: 1px solid rgba(14, 165, 233, 0.12);
    backdrop-filter: blur(14px) saturate(160%);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    box-shadow: var(--shadow-sm);
    align-self: flex-start;
    transition: transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
  }
  /* Certification chips — verifiable credentials next to the Fortune 500 signal */
  .cert-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cert-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.85rem;
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(15, 23, 42, 0.08);
    backdrop-filter: blur(10px) saturate(150%);
    -webkit-backdrop-filter: blur(10px) saturate(150%);
    text-decoration: none;
    color: inherit;
    transition: transform var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
  }
  .cert-chip:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 153, 0, 0.45);
    box-shadow: var(--shadow-sm);
  }
  .cert-icon {
    color: #ff9900;
    flex-shrink: 0;
  }
  .cert-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .cert-name {
    font-size: 0.78rem;
    font-weight: 650;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }
  .cert-level {
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    letter-spacing: 0.01em;
  }

  .fortune-callout:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .callout-icon {
    color: var(--color-accent-secondary);
    flex-shrink: 0;
  }
  .callout-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .callout-kicker {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #4b5563;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .callout-headline {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: #0369a1;
  }

  /* Mobile */
  @media (max-width: 900px) {
    .hero-main {
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: center;
    }
    .hero-left { align-items: center; }
    .hero-right {
      padding-left: 0;
      border-left: none;
      padding-top: 2rem;
      border-top: 1px solid rgba(15, 23, 42, 0.08);
      align-items: center;
    }
    .fortune-callout { align-self: center; }
    .cert-row { justify-content: center; }
  }

  @media (max-width: 720px) {
    .hero-grid-frame { display: none; }
  }

  .scroll-indicator {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-text-tertiary);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    animation: bob 2.5s var(--ease-out) infinite;
  }
  @keyframes bob {
    0%, 100% { transform: translate(-50%, 0); }
    50%      { transform: translate(-50%, 8px); }
  }
</style>
