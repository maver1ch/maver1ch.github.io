---
import { caseStudies, type CaseStudyGroup } from '../../data/case-studies.ts';
import CaseStudyCard from '../case-study-card.astro';

// Founder work first, then enterprise production, academic research, and the freelance go-to-market story last
const blocks: { group: CaseStudyGroup; lead: string; accent: string; lede: string }[] = [
  {
    group: 'startup',
    lead: 'Startup,',
    accent: 'from zero',
    lede: 'The only founding engineer at an EdTech startup: talked to users, pivoted, and shipped the whole product alone.',
  },
  {
    group: 'production',
    lead: 'Production AI,',
    accent: 'shipped',
    lede: 'Enterprise AI shipped to production at FPT Software, HTI Group and HG Group.',
  },
  {
    group: 'research',
    lead: 'Research,',
    accent: 'measured',
    lede: 'Academic work, scored against an expert-annotated benchmark.',
  },
  {
    group: 'freelance',
    lead: 'Freelance,',
    accent: 'client first',
    lede: 'No network and no reviews on a crowded marketplace: how I won my first client, then delivered three jobs in a row.',
  },
];
---

<section class="featured-work" id="work">
  {blocks.map((block) => {
    const studies = caseStudies.filter((study) => study.group === block.group);
    return studies.length > 0 && (
      <div class="work-block" id={`work-${block.group}`}>
        <header class="section-header">
          <h2 class="section-title">
            {block.lead} <span class="grad">{block.accent}</span>.
          </h2>
          <p class="section-lede">{block.lede}</p>
        </header>

        <div class="case-list">
          {studies.map((study, idx) => (
            <CaseStudyCard study={study} index={idx} />
          ))}
        </div>
      </div>
    );
  })}
</section>

<style>
  .featured-work {
    max-width: 1200px;
    margin: 0 auto;
    padding: 6rem 5% 3rem;
    position: relative;
  }

  .section-header {
    max-width: 720px;
    margin: 0 auto 5rem;
    text-align: center;
  }

  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.5rem;
  }
  .eyebrow-line {
    width: 32px;
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent-primary), var(--color-accent-secondary));
  }
  .eyebrow-text {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-accent-primary);
  }

  .section-title {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 1.15;
    letter-spacing: -0.035em;
    margin-bottom: 1.25rem;
    padding-bottom: 0.05em;
    color: var(--color-text-primary);
  }
  .grad {
    background: linear-gradient(135deg, var(--color-accent-primary), var(--color-accent-secondary) 60%, var(--color-accent-tertiary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }


  .section-lede {
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.55;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .work-block + .work-block {
    margin-top: 8rem;
  }

  .case-list {
    display: flex;
    flex-direction: column;
    gap: 5rem;
  }
</style>
