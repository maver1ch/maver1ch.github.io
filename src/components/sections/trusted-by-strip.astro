---
// Social-proof strip placed right under the hero: the companies the work below was built for
const logos = [
  { name: 'FPT Software', tone: '#FF6900', weight: 800, font: 'heading', tracking: '-0.04em',  url: 'https://www.fpt-software.com' },
  { name: 'Covestro AG',  tone: '#00A0DC', weight: 700, font: 'sans',    tracking: '-0.02em',  url: 'https://www.covestro.com',     italic: true },
  { name: 'HTI Group',    tone: '#2563EB', weight: 700, font: 'heading', tracking: '-0.02em',  url: 'https://htigroup.vn/' },
  { name: 'HG Group',     tone: '#16A34A', weight: 700, font: 'sans',    tracking: '-0.02em',  url: 'https://www.facebook.com/hgmediaofficial' },
];
---

<section class="trusted" id="trusted" aria-label="Companies I have built for">
  <div class="trusted-inner reveal">
    <p class="trusted-kicker">Previously built at &amp; trusted by</p>
    <ul class="logo-row">
      {logos.map((l) => (
        <li>
          <a
            class="logo-item"
            href={l.url}
            target="_blank"
            rel="noopener noreferrer"
            style={`--logo-color: ${l.tone}; font-weight: ${l.weight}; letter-spacing: ${l.tracking}; ${l.italic ? 'font-style: italic;' : ''}`}
            data-font={l.font}
            aria-label={`Visit ${l.name}`}
          >
            {l.name}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trusted {
    padding: 0 5%;
  }

  /* One compact band: kicker on the left, logos on the right, hairlines above and below */
  .trusted-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.75rem 0;
    border-top: 1px solid rgba(15, 23, 42, 0.08);
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 3rem;
  }

  .trusted-kicker {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #64748b; /* slate-500 */
    margin: 0;
    white-space: nowrap;
  }

  .logo-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 1rem 3rem;
  }
  .logo-item {
    color: var(--logo-color);
    font-size: 1.4rem;
    line-height: 1;
    opacity: 0.9;
    display: inline-block;
    transition: opacity 320ms var(--ease-premium), transform 320ms var(--ease-premium);
  }
  .logo-item:hover {
    opacity: 1;
    transform: translateY(-2px);
  }
  .logo-item[data-font="heading"] { font-family: var(--font-heading); }
  .logo-item[data-font="sans"]    { font-family: var(--font-sans); }

  @media (max-width: 860px) {
    .trusted-inner {
      flex-direction: column;
      text-align: center;
    }
    .logo-row {
      justify-content: center;
      gap: 1rem 2rem;
    }
    .logo-item { font-size: 1.2rem; }
  }
</style>
