---
// Presentable slide deck inside a case study: one slide at a time, arrow keys,
// click or swipe to step, and a fullscreen mode for presenting live
interface Slide {
  src: string;
  alt: string;
}

interface Props {
  title: string;
  slides: Slide[];
}

const { title, slides } = Astro.props;
---

<section class="slide-deck" data-slide-deck tabindex="0" aria-roledescription="carousel" aria-label={title}>
  <div class="deck-stage" data-deck-stage>
    {slides.map((s, i) => (
      <img
        src={s.src}
        alt={s.alt}
        class="deck-slide"
        data-deck-slide
        width="1920"
        height="1080"
        loading={i === 0 ? 'eager' : 'lazy'}
        decoding="async"
        hidden={i !== 0}
      />
    ))}
  </div>

  <div class="deck-controls">
    <button type="button" class="deck-btn" data-deck-prev aria-label="Previous slide">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <span class="deck-counter" data-deck-counter aria-live="polite">1 / {slides.length}</span>
    <button type="button" class="deck-btn" data-deck-next aria-label="Next slide">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <button type="button" class="deck-btn deck-fullscreen" data-deck-fullscreen aria-label="Present fullscreen" hidden>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
      <span>Present</span>
    </button>
  </div>
</section>

<style>
  .slide-deck {
    margin: 2.5rem 0 4rem;
    outline: none;
  }

  .deck-stage {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 0.85rem;
    overflow: hidden;
    background: var(--color-bg-elevated);
    border: 1px solid rgba(15, 23, 42, 0.06);
    box-shadow: 0 10px 32px rgba(15, 23, 42, 0.10);
    cursor: pointer;
    user-select: none;
  }

  .slide-deck:focus-visible .deck-stage {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 3px;
  }

  /* Two classes deep to beat the case-study prose rule that gives every img a margin and shadow */
  .deck-stage .deck-slide {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    border-radius: 0;
    box-shadow: none;
    object-fit: contain;
  }

  .deck-slide[hidden] {
    display: none;
  }

  .deck-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .deck-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0 0.6rem;
    border-radius: 0.6rem;
    border: 1px solid var(--color-card-border);
    background: var(--color-bg-elevated);
    color: var(--color-text-primary);
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .deck-btn:hover:not(:disabled) {
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
  }

  .deck-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .deck-btn[hidden] {
    display: none;
  }

  .deck-fullscreen {
    margin-left: 0.75rem;
    padding: 0 0.9rem;
    background: var(--color-accent-primary);
    border-color: var(--color-accent-primary);
    color: #fff;
  }

  .deck-fullscreen:hover:not(:disabled) {
    background: #1d4ed8;
    color: #fff;
  }

  .deck-counter {
    min-width: 3.5rem;
    text-align: center;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  /* Presenting: the slide fills the screen on black, controls sit low and quiet */
  .slide-deck:fullscreen {
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin: 0;
    padding: 1.5rem;
    background: #000;
  }

  .slide-deck:fullscreen .deck-stage {
    flex: 1;
    min-height: 0;
    outline: none;
    aspect-ratio: auto;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    background: #000;
  }

  .slide-deck:fullscreen .deck-controls {
    opacity: 0.35;
    transition: opacity 0.2s ease;
  }

  .slide-deck:fullscreen .deck-controls:hover {
    opacity: 1;
  }

  .slide-deck:fullscreen .deck-counter {
    color: #cbd5e1;
  }

  @media (max-width: 600px) {
    .deck-controls {
      gap: 0.5rem;
    }

    .deck-fullscreen {
      margin-left: 0.25rem;
    }
  }
</style>

<script>
  function initDeck(deck: HTMLElement) {
    const slides = Array.from(deck.querySelectorAll<HTMLImageElement>('[data-deck-slide]'));
    const stage = deck.querySelector<HTMLElement>('[data-deck-stage]')!;
    const prev = deck.querySelector<HTMLButtonElement>('[data-deck-prev]')!;
    const next = deck.querySelector<HTMLButtonElement>('[data-deck-next]')!;
    const counter = deck.querySelector<HTMLElement>('[data-deck-counter]')!;
    const fullscreen = deck.querySelector<HTMLButtonElement>('[data-deck-fullscreen]')!;
    let current = 0;

    const show = (index: number) => {
      current = Math.max(0, Math.min(slides.length - 1, index));
      slides.forEach((s, i) => (s.hidden = i !== current));
      counter.textContent = `${current + 1} / ${slides.length}`;
      prev.disabled = current === 0;
      next.disabled = current === slides.length - 1;
    };

    prev.addEventListener('click', () => show(current - 1));
    next.addEventListener('click', () => show(current + 1));

    // Click the right part of the slide to go on, the left third to go back
    stage.addEventListener('click', (e) => {
      const { left, width } = stage.getBoundingClientRect();
      show(e.clientX - left < width / 3 ? current - 1 : current + 1);
    });

    deck.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'PageDown' || e.key === ' ') show(current + 1);
      else if (e.key === 'ArrowLeft' || e.key === 'PageUp') show(current - 1);
      else if (e.key === 'Home') show(0);
      else if (e.key === 'End') show(slides.length - 1);
      else return;
      e.preventDefault();
    });

    let touchX: number | null = null;
    stage.addEventListener('touchstart', (e) => (touchX = e.touches[0].clientX), { passive: true });
    stage.addEventListener('touchend', (e) => {
      if (touchX === null) return;
      const dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 40) show(dx < 0 ? current + 1 : current - 1);
      touchX = null;
    });

    // iPhone Safari has no element fullscreen, so the button only shows where it works
    if (document.fullscreenEnabled) {
      fullscreen.hidden = false;
      fullscreen.addEventListener('click', () => {
        if (document.fullscreenElement) document.exitFullscreen();
        else deck.requestFullscreen().then(() => deck.focus());
      });
      document.addEventListener('fullscreenchange', () => {
        const on = document.fullscreenElement === deck;
        fullscreen.setAttribute('aria-label', on ? 'Exit fullscreen' : 'Present fullscreen');
        fullscreen.querySelector('span')!.textContent = on ? 'Exit' : 'Present';
      });
    }

    // Fetch every slide once the page has settled, so presenting never waits on the network
    window.addEventListener('load', () => slides.forEach((s) => (s.loading = 'eager')), { once: true });

    show(0);
  }

  document.querySelectorAll<HTMLElement>('[data-slide-deck]').forEach(initDeck);
</script>
