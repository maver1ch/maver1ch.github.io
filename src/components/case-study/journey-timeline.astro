---
// Vertical timeline of a product journey: each step names when, what was tried, the signal, and the verdict
type Verdict = 'killed' | 'built' | 'shipped';

interface Step {
  when: string;
  title: string;
  text: string;
  verdict: Verdict;
  label: string;
}

interface Props {
  steps: Step[];
  note?: string;
}

const { steps, note } = Astro.props;
---

<section class="journey reveal" aria-label="Product journey">
  <span class="journey-kicker">The journey</span>
  <ol class="journey-steps">
    {steps.map((s) => (
      <li class:list={['journey-step', s.verdict]}>
        <div class="journey-meta">
          <span class="journey-when">{s.when}</span>
          <span class="journey-verdict">{s.label}</span>
        </div>
        <div class="journey-rail" aria-hidden="true"></div>
        <div class="journey-body">
          <span class="journey-title">{s.title}</span>
          <span class="journey-text">{s.text}</span>
        </div>
      </li>
    ))}
  </ol>
  {note && <p class="journey-note">{note}</p>}
</section>

<style>
  .journey {
    padding: 2.5rem 2.75rem;
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(15, 23, 42, 0.06);
    margin-bottom: 3.5rem;
  }

  .journey-kicker {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent-primary);
    margin-bottom: 2rem;
  }

  /* Doubled class beats the case study's global list margins */
  .journey-steps.journey-steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* One row per step: meta on the left, a rail with a dot in the middle, the story on the right */
  .journey-step.journey-step {
    --dot: var(--color-accent-primary);
    margin: 0;
    display: grid;
    grid-template-columns: 9.5rem 2.5rem 1fr;
    column-gap: 1rem;
  }
  .journey-step.killed  { --dot: #dc2626; }
  .journey-step.shipped { --dot: #16a34a; }

  .journey-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
    padding-top: 0.15rem;
    text-align: right;
  }

  .journey-when {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .journey-verdict {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    white-space: nowrap;
    color: #1d4ed8;
    background: rgba(37, 99, 235, 0.08);
  }
  .killed  .journey-verdict { color: #b91c1c; background: rgba(220, 38, 38, 0.08); }
  .shipped .journey-verdict { color: #15803d; background: rgba(22, 163, 74, 0.10); }

  /* The line runs the full row height so rows join into one track; the last row stops at its dot */
  .journey-rail {
    position: relative;
  }
  .journey-rail::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    transform: translateX(-50%);
    background: rgba(37, 99, 235, 0.18);
  }
  .journey-step:first-child .journey-rail::before { top: 0.55rem; }
  .journey-step:last-child  .journey-rail::before { bottom: auto; height: 0.55rem; }
  .journey-rail::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 0.3rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    transform: translateX(-50%);
    background: var(--dot);
    box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.95), 0 0 0 5px rgba(15, 23, 42, 0.08);
  }

  .journey-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-bottom: 2.25rem;
  }
  .journey-step:last-child .journey-body { padding-bottom: 0; }

  .journey-title {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-text-primary);
  }

  .journey-text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 58ch;
  }

  .journey-note {
    margin: 2rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(15, 23, 42, 0.06);
    font-size: 1rem;
    color: var(--color-text-secondary);
  }

  /* Phone: drop the left column; when and verdict sit above the title */
  @media (max-width: 640px) {
    .journey { padding: 1.75rem 1.25rem; }
    .journey-step.journey-step { grid-template-columns: 1.75rem 1fr; column-gap: 0.75rem; }
    .journey-meta {
      grid-column: 2;
      grid-row: 1;
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.5rem;
      text-align: left;
    }
    .journey-rail { grid-column: 1; grid-row: 1 / span 2; }
    .journey-body { grid-column: 2; grid-row: 2; }
    .journey-title { font-size: 1.15rem; }
    .journey-text { font-size: 1rem; }
  }
</style>
